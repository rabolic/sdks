{
  "name": "@rabolic/web",
  "version": "0.1.0",
  "description": "Rabolic product analytics for the browser: page views, SPA routes, page leave, campaigns, consent.",
  "license": "MIT",
  "homepage": "https://rabolic.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabolic/sdks.git",
    "directory": "js/web"
  },
  "bugs": {
    "url": "https://github.com/rabolic/sdks/issues"
  },
  "keywords": [
    "analytics",
    "product-analytics",
    "rabolic",
    "browser"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/rabolic.global.js",
  "jsdelivr": "./dist/rabolic.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rabolic.global.js": "./dist/rabolic.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "snippet",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown && node scripts/size.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rabolic/sdk-core": "workspace:*",
    "@rabolic/test-utils": "workspace:*"
  }
}
