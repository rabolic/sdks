{
  "name": "@rabolic/node",
  "version": "0.2.0",
  "description": "Rabolic server SDK for Node.js: server-side events, verified revenue and checkout metadata.",
  "license": "MIT",
  "homepage": "https://github.com/rabolic/sdks/tree/main/js/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabolic/sdks.git",
    "directory": "js/node"
  },
  "bugs": {
    "url": "https://github.com/rabolic/sdks/issues"
  },
  "keywords": [
    "analytics",
    "product-analytics",
    "rabolic",
    "server"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rabolic/sdk-core": "workspace:*",
    "@rabolic/test-utils": "workspace:*"
  }
}
