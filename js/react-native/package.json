{
  "name": "@rabolic/react-native",
  "version": "0.2.0",
  "description": "Rabolic product analytics for React Native and Expo: app lifecycle, sessions, screens, identity and deep links.",
  "license": "MIT",
  "homepage": "https://github.com/rabolic/sdks/tree/main/js/react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabolic/sdks.git",
    "directory": "js/react-native"
  },
  "bugs": {
    "url": "https://github.com/rabolic/sdks/issues"
  },
  "keywords": [
    "analytics",
    "product-analytics",
    "rabolic",
    "react-native",
    "expo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@rabolic/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "react-native": ">=0.72.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rabolic/sdk-core": "workspace:*",
    "@rabolic/test-utils": "workspace:*"
  }
}
